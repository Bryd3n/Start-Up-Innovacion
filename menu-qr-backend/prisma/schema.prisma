generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Restaurant {
  id          String     @id @default(uuid())
  userId      String     // Simulated user ID for MVP
  name        String
  slug        String     @unique
  logoUrl     String?
  themeColor  String     @default("#f97316")
  createdAt   DateTime   @default(now())
  categories  Category[]
}

model Category {
  id           String     @id @default(uuid())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String
  name         String
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  menuItems    MenuItem[]
}

model MenuItem {
  id          String   @id @default(uuid())
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  name        String
  description String?
  price       Float
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
}
